{
  "manifest_version": 3,
  "name": "XTwitter-void",
  "version": "1.0.0",
  "description": "Hides promoted ads and sponsored posts on X. Also blocks feed ads on Reddit, Instagram, YouTube and Facebook.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "XTwitter-void",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://twitter.com/*",
        "*://*.reddit.com/*",
        "*://*.instagram.com/*",
        "*://*.youtube.com/*",
        "*://*.facebook.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
